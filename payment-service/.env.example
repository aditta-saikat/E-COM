PORT=3005
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB Configuration
MONGODB_URI=mongodb+srv://aditta_saikat:penguin007@cluster0.2jxyc6x.mongodb.net/e-commerce?retryWrites=true&w=majority&appName=Cluster0MONGODB_URI=mongodb://localhost:27017/payment-service

INTERNAL_API_KEY=change-me-shared-between-internal-services

# mock (default, no real calls), stripe (Stripe test mode) or sslcommerz
PAYMENT_PROVIDER=mock

# Only needed when PAYMENT_PROVIDER=stripe. Must be a TEST key (sk_test_...) from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Optional: a Stripe test payment method. Default pm_card_visa (succeeds). Try pm_card_chargeDeclined to test a decline.
STRIPE_TEST_PAYMENT_METHOD=

ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSLCommerz (PAYMENT_PROVIDER=sslcommerz). Sandbox credentials from https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# Where SSLCommerz sends the customer's browser (reachable from the browser) and the app to return to
PUBLIC_PAYMENT_URL=http://localhost:3005
FRONTEND_URL=http://localhost:5173
# Used to tell order-service the payment result
ORDER_SERVICE_URL=http://localhost:3004
