# Used by docker-compose.yml (copy to .env). Per-service .env files are NOT used by Docker.

# Must be a long random string, shared by auth, product-catalog, cart and order.
JWT_SECRET=change-me-to-a-long-random-string

# Shared by auth, product-catalog, order and payment for internal calls.
INTERNAL_API_KEY=change-me-shared-between-internal-services

# Baked into the frontend image at build time (visible in the browser). Optional.
VITE_IMGBB_API_KEY=

# Payments: mock (default), stripe (test key) or sslcommerz (sandbox credentials)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
