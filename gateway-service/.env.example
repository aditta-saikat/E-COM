PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Must be the same secret the services use: the gateway verifies tokens before forwarding them.
JWT_SECRET=change-me-shared-with-all-services

# Browsers allowed to call the gateway (comma separated).
CORS_ORIGINS=http://localhost:5173

# Where each service lives. In Docker these are the compose service names.
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_CATALOG_URL=http://localhost:3002
CART_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005

# Requests per minute per IP: everything, and login/signup specifically.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
